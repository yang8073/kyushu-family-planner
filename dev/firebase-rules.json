{
  "rules": {
    ".read": false,
    ".write": false,
    "trips": {
      "$code": {
        ".read": "$code.matches(/^[A-Za-z0-9_-]{16,64}$/)",
        ".write": "$code.matches(/^[A-Za-z0-9_-]{16,64}$/)",
        "plan": {
          ".validate": "newData.hasChildren(['days'])"
        },
        "wishes": {
          "$spot": {
            "$dev": {
              ".validate": "newData.hasChildren(['pool', 'nick', 'at']) && (newData.child('pool').val() === 'want' || newData.child('pool').val() === 'maybe' || newData.child('pool').val() === 'meh') && newData.child('nick').isString() && newData.child('nick').val().length >= 1 && newData.child('nick').val().length <= 12 && newData.child('at').isNumber()",
              "pool": {},
              "nick": {},
              "at": {},
              "$other": { ".validate": false }
            }
          }
        },
        "members": {
          "$dev": {
            ".validate": "newData.hasChildren(['nick', 'at']) && newData.child('nick').isString() && newData.child('nick').val().length >= 1 && newData.child('nick').val().length <= 12 && newData.child('at').isNumber()",
            "nick": {},
            "at": {},
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
