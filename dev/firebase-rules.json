{
  "rules": {
    ".read": false,
    ".write": false,
    "kyushu2027": {
      ".read": true,
      "state": {
        ".validate": "newData.hasChildren(['rev','at','by','byId','summary']) && newData.child('rev').isNumber() && newData.child('rev').val() >= 1 && newData.child('rev').val() % 1 === 0 && newData.child('at').isNumber() && newData.child('by').isString() && newData.child('by').val().length >= 1 && newData.child('by').val().length <= 12 && newData.child('byId').isString() && newData.child('byId').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.child('summary').isString() && newData.child('summary').val().length >= 1 && newData.child('summary').val().length <= 2000 && newData.child('plan').hasChildren(['days'])",
        "rev": {},
        "at": {},
        "by": {},
        "byId": {},
        "summary": {},
        "customs": {},
        "tagDefs": {},
        "$other": {
          ".validate": false
        },
        "plan": {
          ".validate": "newData.hasChildren(['days']) && ((!newData.hasChild('times') && !newData.hasChild('transport')) || newData.child('scheduleVersion').val() === 1)",
          "scheduleVersion": {
            ".validate": "newData.val() === 1"
          },
          "times": {
            ".validate": "newData.hasChildren()",
            "$spot": {
              ".validate": "$spot.matches(/^[a-z0-9_]{1,40}$/) && $spot !== '__proto__' && $spot !== 'constructor' && $spot !== 'prototype' && (newData.hasChild('arrival') || newData.hasChild('departure'))",
              "arrival": {
                ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
              },
              "departure": {
                ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "transport": {
            ".validate": "newData.hasChildren()",
            "$dayId": {
              ".validate": "newData.hasChildren() && $dayId.matches(/^[A-Za-z0-9_-]{1,64}$/) && $dayId !== '__proto__' && $dayId !== 'constructor' && $dayId !== 'prototype'",
              "$from": {
                ".validate": "$from.matches(/^[a-z0-9_]{1,40}$/) && $from !== '__proto__' && $from !== 'constructor' && $from !== 'prototype' && newData.hasChildren(['to','mode'])",
                "to": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/) && newData.val() !== $from && newData.val() !== '__proto__' && newData.val() !== 'constructor' && newData.val() !== 'prototype'"
                },
                "mode": {
                  ".validate": "newData.isString() && newData.val().matches(/^(walk|train|shinkansen|subway|bus|car|charter|taxi|ferry|other)$/)"
                },
                "note": {
                  ".validate": "newData.isString() && newData.val().matches(/^[\\s\\S]{1,100}$/)"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "days": {
            "$day": {
              ".validate": "newData.hasChildren(['id','label']) && newData.child('id').isString() && newData.child('label').isString() && newData.child('label').val().length >= 1 && newData.child('label').val().length <= 2000",
              "id": {},
              "label": {},
              "items": {
                "$item": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/)"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "pool": {
            "$item": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/)"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "wishes": {
          "$spot": {
            ".validate": "$spot.matches(/^[a-z0-9_]{1,40}$/) && $spot !== '__proto__' && $spot !== 'constructor' && $spot !== 'prototype'",
            "$device": {
              ".validate": "$device.matches(/^[A-Za-z0-9_-]{1,64}$/) && $device !== '__proto__' && $device !== 'constructor' && $device !== 'prototype' && newData.hasChildren(['pool','nick','at']) && newData.child('pool').isString() && (newData.child('pool').val() === 'want' || newData.child('pool').val() === 'maybe' || newData.child('pool').val() === 'meh') && newData.child('nick').isString() && newData.child('nick').val().length >= 1 && newData.child('nick').val().length <= 12 && newData.child('at').isNumber()",
              "pool": {},
              "nick": {},
              "at": {},
              "$other": {
                ".validate": false
              }
            }
          }
        },
        ".write": "newData.exists() && (!data.child('plan').hasChild('scheduleVersion') || newData.child('plan').child('scheduleVersion').val() === 1) && ((!data.exists() && newData.child('rev').val() === 1) || (data.exists() && newData.child('rev').val() === data.child('rev').val() + 1))"
      },
      "history": {
        "$rev": {
          ".validate": "newData.hasChildren(['rev','at','by','byId','summary']) && newData.child('rev').isNumber() && newData.child('rev').val() >= 1 && newData.child('rev').val() % 1 === 0 && newData.child('at').isNumber() && newData.child('by').isString() && newData.child('by').val().length >= 1 && newData.child('by').val().length <= 12 && newData.child('byId').isString() && newData.child('byId').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.child('summary').isString() && newData.child('summary').val().length >= 1 && newData.child('summary').val().length <= 2000 && newData.child('plan').hasChildren(['days'])",
          "rev": {},
          "at": {},
          "by": {},
          "byId": {},
          "summary": {},
          "customs": {},
          "tagDefs": {},
          "$other": {
            ".validate": false
          },
          "plan": {
            ".validate": "newData.hasChildren(['days']) && ((!newData.hasChild('times') && !newData.hasChild('transport')) || newData.child('scheduleVersion').val() === 1)",
            "scheduleVersion": {
              ".validate": "newData.val() === 1"
            },
            "times": {
              ".validate": "newData.hasChildren()",
              "$spot": {
                ".validate": "$spot.matches(/^[a-z0-9_]{1,40}$/) && $spot !== '__proto__' && $spot !== 'constructor' && $spot !== 'prototype' && (newData.hasChild('arrival') || newData.hasChild('departure'))",
                "arrival": {
                  ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
                },
                "departure": {
                  ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "transport": {
              ".validate": "newData.hasChildren()",
              "$dayId": {
                ".validate": "newData.hasChildren() && $dayId.matches(/^[A-Za-z0-9_-]{1,64}$/) && $dayId !== '__proto__' && $dayId !== 'constructor' && $dayId !== 'prototype'",
                "$from": {
                  ".validate": "$from.matches(/^[a-z0-9_]{1,40}$/) && $from !== '__proto__' && $from !== 'constructor' && $from !== 'prototype' && newData.hasChildren(['to','mode'])",
                  "to": {
                    ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/) && newData.val() !== $from && newData.val() !== '__proto__' && newData.val() !== 'constructor' && newData.val() !== 'prototype'"
                  },
                  "mode": {
                    ".validate": "newData.isString() && newData.val().matches(/^(walk|train|shinkansen|subway|bus|car|charter|taxi|ferry|other)$/)"
                  },
                  "note": {
                    ".validate": "newData.isString() && newData.val().matches(/^[\\s\\S]{1,100}$/)"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              }
            },
            "days": {
              "$day": {
                ".validate": "newData.hasChildren(['id','label']) && newData.child('id').isString() && newData.child('label').isString() && newData.child('label').val().length >= 1 && newData.child('label').val().length <= 2000",
                "id": {},
                "label": {},
                "items": {
                  "$item": {
                    ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/)"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "pool": {
              "$item": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/)"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "wishes": {
            "$spot": {
              ".validate": "$spot.matches(/^[a-z0-9_]{1,40}$/) && $spot !== '__proto__' && $spot !== 'constructor' && $spot !== 'prototype'",
              "$device": {
                ".validate": "$device.matches(/^[A-Za-z0-9_-]{1,64}$/) && $device !== '__proto__' && $device !== 'constructor' && $device !== 'prototype' && newData.hasChildren(['pool','nick','at']) && newData.child('pool').isString() && (newData.child('pool').val() === 'want' || newData.child('pool').val() === 'maybe' || newData.child('pool').val() === 'meh') && newData.child('nick').isString() && newData.child('nick').val().length >= 1 && newData.child('nick').val().length <= 12 && newData.child('at').isNumber()",
                "pool": {},
                "nick": {},
                "at": {},
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          ".write": "!data.exists() && newData.exists() && $rev.matches(/^[0-9]{6,}$/)"
        }
      },
      "historyIndex": {
        "$rev": {
          ".validate": "newData.hasChildren(['rev','at','by','byId','summary']) && newData.child('rev').isNumber() && newData.child('rev').val() >= 1 && newData.child('rev').val() % 1 === 0 && newData.child('at').isNumber() && newData.child('by').isString() && newData.child('by').val().length >= 1 && newData.child('by').val().length <= 12 && newData.child('byId').isString() && newData.child('byId').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.child('summary').isString() && newData.child('summary').val().length >= 1 && newData.child('summary').val().length <= 2000",
          "rev": {},
          "at": {},
          "by": {},
          "byId": {},
          "summary": {},
          "customs": {},
          "tagDefs": {},
          "$other": {
            ".validate": false
          },
          ".write": "!data.exists() && newData.exists() && $rev.matches(/^[0-9]{6,}$/)"
        }
      },
      "$other": {
        ".write": false,
        ".validate": false
      }
    }
  }
}
